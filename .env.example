# KasiDeposit UI configuration. Copy to .env (gitignored) and adjust if needed.
#
# EXPO_PUBLIC_* variables are bundled into the client at build time and are
# visible to anyone who unpacks the app — never put secrets here.
#
# After changing this file: restart with `npx expo start --clear`, AND fully
# reload the app on the device (shake for the dev menu, tap Reload; or close
# and reopen it). A server restart alone is not enough — EXPO_PUBLIC_* values
# are baked into the JS bundle once at load time, and an already-running app
# keeps its old bundle in memory until it is explicitly reloaded.

# true  = in-memory fake API, driven by the PIN's last digit (see TESTING.md).
#         No backend needed; this is the default for a fresh clone.
# false = the real backend at EXPO_PUBLIC_API_BASE_URL below.
EXPO_PUBLIC_USE_FAKE_API=true

# Only read when EXPO_PUBLIC_USE_FAKE_API=false.
#
# Local backend on this Wi-Fi (find your PC's LAN IP; the phone must be on the
# same network — this is a LAN address, not something to share or commit):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:8000/v1
#
# The hosted backend on Render:
# EXPO_PUBLIC_API_BASE_URL=https://kasidepositapi.onrender.com/v1
EXPO_PUBLIC_API_BASE_URL=
